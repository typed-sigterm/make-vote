{
  "$id": "https://make-vote.by-ts.top/schemas/ballot-qr.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/$defs/__schema0"
    },
    "project": {
      "$ref": "#/$defs/__schema1"
    },
    "serial": {
      "$ref": "#/$defs/__schema2"
    },
    "unique": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "$schema",
    "project",
    "serial",
    "unique"
  ],
  "additionalProperties": false,
  "description": "Make Vote 选票二维码负载",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "https://make-vote.by-ts.top/schemas/ballot-qr.v1.schema.json"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "发行此选票时的项目 GUID"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999
    },
    "__schema3": {
      "type": "string",
      "pattern": "^\\d{12}$"
    }
  }
}
