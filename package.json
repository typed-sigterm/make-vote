{
  "type": "module",
  "private": true,
  "scripts": {
    "schema:generate": "bun run scripts/generate-schemas.ts",
    "schema:check": "bun run scripts/generate-schemas.ts --check",
    "build": "bun run schema:check && nuxt build",
    "dev": "portless",
    "dev:port": "nuxt dev",
    "deploy": "bunx wrangler deploy --config wrangler.jsonc",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "bun test",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/vue-3": "^3.34.0",
    "nuxt": "^4.6.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/lucide": "^1.2.154",
    "@playwright/test": "^1.65.1",
    "@typed-sigterm/eslint-config": "^1.7.1",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cf": "^1.0.0-beta.32",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "portless": {
    "name": "make-vote",
    "script": "dev:port"
  }
}
